{
  "manifest_version": 3,
  "name": "Pathix for Dynamics 365",
  "version": "0.0.1",
  "description": "Dynamics 365 fields: what is registered to fire, why one is locked, and, with Pathix, what writes it. Not affiliated with Microsoft.",
  "minimum_chrome_version": "113",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "identity",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "https://admin.powerplatform.microsoft.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "action": {
    "default_title": "Pathix: X-ray, event map, what changed and save preview for Dynamics 365 forms",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+Q", "mac": "MacCtrl+Shift+Q" },
      "description": "Open the Pathix window"
    },
    "toggle-xray": {
      "description": "Turn X-ray on or off"
    },
    "open-event-map": {
      "description": "Open the form event map"
    },
    "open-what-changed": {
      "description": "Open what changed on this table"
    },
    "open-save-preview": {
      "description": "Open the save preview"
    },
    "open-field-card": {
      "description": "Open the card for the field that has focus"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dynamics.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.dynamics.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
